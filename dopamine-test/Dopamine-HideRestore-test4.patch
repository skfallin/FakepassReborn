diff --git a/tests/check_hide_restore.py b/tests/check_hide_restore.py
new file mode 100644
index 0000000..ffe06d0
--- /dev/null
+++ b/tests/check_hide_restore.py
@@ -0,0 +1,215 @@
+#!/usr/bin/env python3
+"""Exercise the real hide/unhide method with mocked device operations on macOS."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = (root / "Application/Dopamine/Jailbreak/DOEnvironmentManager.m").read_text()
+start = source.index("setJailbreakHidden:(BOOL)hidden")
+start = source.rfind("\n- (", 0, start) + 1
+body = source.index("{", start)
+depth = 1
+end = body + 1
+while depth:
+    depth += (source[end] == "{") - (source[end] == "}")
+    end += 1
+method = source[start:end].replace("NSFileManager", "TestFileManager")
+returns_error = method.startswith("- (NSError")
+signature = method[:method.index("{")].strip() + ";"
+call = "NSError *error = [env setJailbreakHidden:hidden];" if returns_error else "[env setJailbreakHidden:hidden]; NSError *error = nil;"
+
+harness = r'''
+#import <Foundation/Foundation.h>
+#include <errno.h>
+#include <unistd.h>
+
+static int rootDepth, sandboxDepth, mountFailure, domainFailure, protectionFailure;
+static BOOL visible, mounted, domainEnabled, protected, fileFailure, rootDenied, mountNoop, fileNoop;
+static BOOL platformBinary, checkinNoop, csopsFailure;
+static int checkinFailure, checkinCount;
+static BOOL jailbroken = YES;
+static int refreshCount, unregisterCount;
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "Failed: %s (line %d)\n", #c, __LINE__); exit(1); } } while (0)
+#define JBROOT_PATH(path) @"/private/test-jb"
+#define geteuid() 501
+#define CS_OPS_STATUS 0
+#define CS_PLATFORM_BINARY 0x04000000
+
+static int csops(pid_t pid, unsigned int op, void *value, size_t size) {
+    if (csopsFailure) return -1;
+    *(uint32_t *)value = platformBinary ? CS_PLATFORM_BINARY : 0;
+    return 0;
+}
+
+static int jbclient_process_checkin(char **root, char **boot, char **extensions, bool *debugged, bool *adhoc) {
+    CHECK(rootDepth == 0 && sandboxDepth == 0);
+    CHECK(unregisterCount == 0 && refreshCount == 0);
+    checkinCount++;
+    if (checkinFailure) return checkinFailure;
+    if (!checkinNoop) platformBinary = YES;
+    return 0;
+}
+
+static int jbclient_platform_set_systemwide_domain_enabled(BOOL enabled) {
+    if (!platformBinary) return -2;
+    if (domainFailure) return domainFailure;
+    domainEnabled = enabled;
+    return enabled;
+}
+
+@interface TestFileManager : NSObject
++ (instancetype)defaultManager;
+- (BOOL)removeItemAtPath:(NSString *)path error:(NSError **)error;
+- (BOOL)createSymbolicLinkAtPath:(NSString *)path withDestinationPath:(NSString *)destination error:(NSError **)error;
+@end
+@implementation TestFileManager
++ (instancetype)defaultManager { static id manager; if (!manager) manager = [self new]; return manager; }
+- (BOOL)removeItemAtPath:(NSString *)path error:(NSError **)error {
+    CHECK(!jailbroken || (rootDepth > 0 && sandboxDepth > 0));
+    if (fileFailure) { if (error) *error = [NSError errorWithDomain:NSPOSIXErrorDomain code:EACCES userInfo:nil]; return NO; }
+    if (!fileNoop) visible = NO; return YES;
+}
+- (BOOL)createSymbolicLinkAtPath:(NSString *)path withDestinationPath:(NSString *)destination error:(NSError **)error {
+    CHECK(!jailbroken || (rootDepth > 0 && sandboxDepth > 0));
+    if (fileFailure) { if (error) *error = [NSError errorWithDomain:NSPOSIXErrorDomain code:EACCES userInfo:nil]; return NO; }
+    if (!fileNoop) visible = YES; return YES;
+}
+@end
+
+@interface DOEnvironmentManager : NSObject
+- (BOOL)isJailbroken;
+- (BOOL)isJailbreakHidden;
+- (BOOL)isInstalledThroughTrollStore;
+- (BOOL)isFakelibMounted;
+- (int)runTrollStoreAction:(NSString *)action;
+- (void)runAsRoot:(void (^)(void))block;
+- (void)runUnsandboxed:(void (^)(void))block;
+- (int)setFakelibMounted:(BOOL)value;
+- (int)setPrivatePrebootProtected:(BOOL)value;
+- (void)refreshJailbreakApps;
+- (void)unregisterJailbreakApps;
+METHOD_SIGNATURE
+@end
+@implementation DOEnvironmentManager
+- (BOOL)isJailbroken { return jailbroken; }
+- (BOOL)isJailbreakHidden { return !visible; }
+- (BOOL)isInstalledThroughTrollStore { return YES; }
+- (BOOL)isFakelibMounted { return mounted; }
+- (int)runTrollStoreAction:(NSString *)action { visible = NO; return 0; }
+- (void)runAsRoot:(void (^)(void))block { if (rootDenied) return; rootDepth++; block(); rootDepth--; }
+- (void)runUnsandboxed:(void (^)(void))block { sandboxDepth++; block(); sandboxDepth--; }
+- (int)setFakelibMounted:(BOOL)value {
+    // jbctl's wait handshake must run after the app has restored its credentials.
+    CHECK(rootDepth == 0 && sandboxDepth == 0);
+    if (mountFailure) return mountFailure;
+    if (!mountNoop) mounted = value; return 0;
+}
+- (int)setPrivatePrebootProtected:(BOOL)value {
+    CHECK(rootDepth == 0 && sandboxDepth == 0);
+    if (protectionFailure) return protectionFailure;
+    protected = value; return 0;
+}
+- (void)refreshJailbreakApps { CHECK(rootDepth == 0); refreshCount++; }
+- (void)unregisterJailbreakApps { CHECK(rootDepth == 0); unregisterCount++; }
+METHOD_BODY
+@end
+
+static NSError *change(DOEnvironmentManager *env, BOOL hidden) {
+    METHOD_CALL
+    CHECK(rootDepth == 0 && sandboxDepth == 0);
+    return error;
+}
+
+static void reset(BOOL hidden) {
+    visible = mounted = domainEnabled = protected = !hidden;
+    fileFailure = rootDenied = mountNoop = fileNoop = NO;
+    mountFailure = domainFailure = protectionFailure = 0;
+    refreshCount = unregisterCount = rootDepth = sandboxDepth = 0;
+    jailbroken = YES;
+    platformBinary = YES;
+    checkinNoop = csopsFailure = NO;
+    checkinFailure = checkinCount = 0;
+}
+
+int main(void) { @autoreleasepool {
+    DOEnvironmentManager *env = [DOEnvironmentManager new];
+    reset(YES);
+    CHECK(change(env, NO) == nil);
+    CHECK(visible && mounted && domainEnabled && protected && refreshCount == 1);
+    CHECK(change(env, YES) == nil);
+    CHECK(!visible && !mounted && !domainEnabled && !protected);
+    CHECK(change(env, NO) == nil);
+    CHECK(visible && mounted && domainEnabled && protected);
+
+    // Every app relaunch may lack systemhook, including while the jailbreak is hidden.
+    reset(NO);
+    for (int cycle = 0; cycle < 3; cycle++) {
+        platformBinary = NO; unregisterCount = refreshCount = 0;
+        CHECK(change(env, YES) == nil);
+        CHECK(!visible && !mounted && !domainEnabled && !protected);
+        platformBinary = NO; unregisterCount = refreshCount = 0;
+        CHECK(change(env, NO) == nil);
+        CHECK(visible && mounted && domainEnabled && protected);
+    }
+    CHECK(checkinCount == 6);
+    for (int failure = 0; failure < 3; failure++) {
+        reset(NO); platformBinary = NO;
+        if (failure == 0) checkinFailure = -2;
+        if (failure == 1) checkinNoop = YES;
+        if (failure == 2) csopsFailure = YES;
+        CHECK(change(env, YES) != nil);
+        CHECK(visible && mounted && domainEnabled && protected);
+        CHECK(unregisterCount == 0 && refreshCount == 0);
+    }
+
+    // A failed earlier restore may have recreated /var/jb without restoring injection.
+    reset(NO); mounted = domainEnabled = protected = NO;
+    CHECK(change(env, NO) == nil);
+    CHECK(mounted && domainEnabled && protected && refreshCount == 1);
+
+    reset(YES); fileFailure = YES;
+    CHECK(change(env, NO) != nil);
+    CHECK(!visible && !mounted && refreshCount == 0);
+    reset(YES); rootDenied = YES;
+    CHECK(change(env, NO) != nil);
+    CHECK(!visible && !mounted && refreshCount == 0);
+    reset(YES); fileNoop = YES;
+    CHECK(change(env, NO) != nil);
+    CHECK(!visible && !mounted && refreshCount == 0);
+    reset(YES); domainFailure = -1;
+    CHECK(change(env, NO) != nil);
+    CHECK(!mounted && refreshCount == 0);
+    reset(YES); mountFailure = EIO;
+    CHECK(change(env, NO) != nil);
+    CHECK(!mounted && refreshCount == 0);
+    mountFailure = 0;
+    CHECK(change(env, NO) == nil);
+    CHECK(mounted && protected && refreshCount == 1);
+    reset(YES); protectionFailure = EIO;
+    CHECK(change(env, NO) != nil);
+    CHECK(refreshCount == 0);
+    reset(YES); mountNoop = YES;
+    CHECK(change(env, NO) != nil);
+    CHECK(!mounted && refreshCount == 0);
+    reset(NO); fileFailure = YES;
+    CHECK(change(env, YES) != nil);
+    CHECK(visible && mounted && domainEnabled && protected && refreshCount == 1);
+    reset(NO); mountNoop = YES;
+    CHECK(change(env, YES) != nil);
+    CHECK(visible && mounted && domainEnabled && protected);
+    reset(NO); domainFailure = -1;
+    CHECK(change(env, YES) != nil);
+    CHECK(visible && mounted && domainEnabled && protected);
+    reset(YES); jailbroken = NO;
+    CHECK(change(env, NO) == nil);
+    CHECK(visible && !mounted && !domainEnabled && !protected);
+    puts("Hide/unhide sequencing, retry and error checks passed (mocked device operations).");
+} }
+'''.replace("METHOD_SIGNATURE", signature).replace("METHOD_BODY", method).replace("METHOD_CALL", call)
+
+with tempfile.TemporaryDirectory(prefix="dopamine-hide-test-") as temporary:
+    path = Path(temporary)
+    (path / "test.m").write_text(harness)
+    subprocess.run(["xcrun", "--sdk", "macosx", "clang", "-fobjc-arc", "-fblocks", "-framework", "Foundation", str(path / "test.m"), "-o", str(path / "test")], check=True)
+    subprocess.run([str(path / "test")], check=True)
